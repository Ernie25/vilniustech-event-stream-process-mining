    <event>
      <string key="concept:name" value="process"/>
      <date key="time:timestamp" value="2024-01-01T10:05:00.000+00:00"/>
      <string key="org:resource" value="user1"/>
    </event>
    <event>
      <string key="concept:name" value="end"/>
      <date key="time:timestamp" value="2024-01-01T10:10:00.000+00:00"/>
    </event>
  </trace>
